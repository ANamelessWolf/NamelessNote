PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,https://localhost:3000,http://192.168.1.235:3000,https://192.168.1.235:3000
MONGO_URI=mongodb://NamelessNoteDB:27017/namelessnote
# Optional: overrides MONGO_URI for db_dump_sqlite/db_dump_data when run from
# the host (outside Docker), where the compose service hostname doesn't
# resolve. Example: mongodb://localhost:27018/namelessnote
MONGO_URI_DUMP=
GOOGLE_CLIENT_ID=PUT_YOUR_GOOGLE_CLIENT_ID
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
DATA_ENCRYPTION_KEY=base64_or_hex_32_byte_key
DATA_ENCRYPTION_ALGORITHM=aes-256-gcm
# SQLCipher passphrase for the mobile app's bundled .sqlite export (generate
# with `openssl rand -base64 32`). Passed to the Flutter build as
# VAULT_PASSPHRASE via --dart-define; `npm run mobile:apk` reads this value
# and does that for you automatically (see scripts/build-mobile-apk.js).
MOBILE_DB_ENCRYPTION_KEY=
# Optional access password for the mobile app (asked after the fingerprint/PIN).
# Read only by scripts/build-mobile-apk.js, which bakes in a salted hash — never
# the password itself. Leave empty to disable. Write it raw: no quotes, and it
# must not contain '#'.
MOBILE_ACCESS_PASSWORD=
DEBUG=false
HTTPS_ENABLED=false
HTTPS_CERT_FILE=../certs/namelessnote-local.pem
HTTPS_KEY_FILE=../certs/namelessnote-local-key.pem

